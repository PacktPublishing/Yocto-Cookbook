{
    "description": "OpenEmbedded Core nodistro CI configuration",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "master",
                "rev": "master"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "master",
                "rev": "master"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "name": "nodistro",
                "description": "OpenEmbedded Core with nodistro",
                "bb-layers": [
                    "openembedded-core/meta"
                ],
                "oe-fragments": [
                    "core/testimage"
                ],
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machine",
                        "options": [
                            {
                                "name": "machine/qemux86-64",
                                "description": "x86-64 system running under QEMU"
                            },
                            {
                                "name": "machine/qemuarm64",
                                "description": "ARM64 system running under QEMU"
                            }
                        ]
                    }
                }
            }
        ]
    },
    "version": "1.0"
}
